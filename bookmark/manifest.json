{
  "manifest_version": 3,
  "name": "Maple Bookmarks",
  "description": "Let you navigate smoothly while hiding the bookmark bar.",
  "version": "2.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      }
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Command+B"
      },
      "description": "Open or close the sidebar"
    }
  },
  "optional_host_permissions": ["<all_urls>"],
  "optional_permissions": ["tabs"],
  "permissions": ["activeTab", "bookmarks", "favicon", "sidePanel", "storage"],
  "options_page": "settings.html",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
